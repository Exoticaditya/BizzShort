# Environment Variables for BizzShort
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?appName=BizzShort

# Security
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_characters
JWT_EXPIRE=30d

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=https://bizzshort.com,https://www.bizzshort.com,http://localhost:3000

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880

# ============ External APIs ============
CURRENTS_API_KEY=your_currents_api_key_here

# Admin credentials for scripts (import_youtube.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# ============ YouTube API Configuration ============
# Required for automatic video sync from @bizz_short channel
# Get API key from: https://console.cloud.google.com/
# Enable: YouTube Data API v3

YT_API_KEY=your_youtube_api_key_here
YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxx
YT_MAX_RESULTS=20

# ============ Video Sync Settings ============
# Daily auto-sync runs at 8:00 AM IST with transcription
# Ensure YT_API_KEY and YT_CHANNEL_ID are set above
